# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# RAG local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=educational_documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Investigación web
TAVILY_API_KEY=
MAX_RESEARCH_ITERATIONS=2

# Langfuse SDK (se obtienen al crear un proyecto en http://localhost:3000)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
